{
  "_meta": {
    "project": "North Health GPT",
    "version": "1.0.0-schema",
    "rfps": "RFPS-NYH-2026-503931",
    "description": "Preliminary schema for the North Health GPT hospital referral database. Full 19-state database to be field-compiled and validated during Months 2–5 of the investment period.",
    "coverage": "Northern Nigeria — 19 states (preliminary Kano State entries included)",
    "license": "MIT — https://github.com/kanaltech/north-health-gpt/blob/main/LICENSE",
    "last_updated": "2026-07",
    "prototype_data_notice": "Sample facilities in this repository are illustrative prototype records and are not verified for live referral decisions. All facility names, capabilities, coordinates and service details must be validated against authoritative sources before production use."
  },
  "schema": {
    "facility": {
      "id": "string — unique facility identifier (e.g. KN-SEC-001)",
      "name": "string — official government facility name",
      "type": "enum — PHC | Secondary | Tertiary | Teaching | EmOC | DOTS | TFC | Emergency",
      "state": "string — Northern Nigerian state name",
      "lga": "string — Local Government Area name",
      "ward": "string — ward name (optional)",
      "address": "string — street address or landmark description",
      "coordinates": {
        "lat": "number — latitude (decimal degrees)",
        "lon": "number — longitude (decimal degrees)"
      },
      "capabilities": {
        "eoc": "boolean — Emergency Obstetric Care capability",
        "lumbar_puncture": "boolean — lumbar puncture / CSF analysis",
        "scbu": "boolean — Special Care Baby Unit / neonatal care",
        "sam_ward": "boolean — Severe Acute Malnutrition treatment ward",
        "therapeutic_feeding_centre": "boolean — Outpatient Therapeutic Programme (OTP) / TFC",
        "dots_tb": "boolean — DOTS-certified TB testing and treatment (GeneXpert)",
        "blood_transfusion": "boolean — blood transfusion available",
        "surgery": "boolean — surgical capability",
        "x_ray": "boolean — X-ray available",
        "laboratory": "boolean — basic laboratory services"
      },
      "conditions_served": [
        "enum array — MATERNAL | NEWBORN | MENINGITIS | SAM | TB"
      ],
      "hours": "string — operating hours (e.g. 24/7 | 8:00-16:00 Mon-Fri)",
      "phone": "string — facility phone number (if available)",
      "verified": "boolean — on-site field verification completed",
      "verification_date": "string — ISO date of last field verification",
      "data_source": "string — source of facility data (e.g. FMOH, state MoH, field verification)"
    }
  },
  "referral_logic": {
    "description": "Condition-to-facility-type mapping used by the North Health GPT referral engine",
    "mappings": {
      "MATERNAL_EMERGENCY": {
        "required_capability": "eoc",
        "minimum_facility_type": "Secondary",
        "preferred_facility_type": "EmOC",
        "urgency": "IMMEDIATE",
        "max_travel_time_minutes": 120
      },
      "NEWBORN_DANGER": {
        "required_capability": "scbu",
        "minimum_facility_type": "Secondary",
        "preferred_facility_type": "Tertiary",
        "urgency": "IMMEDIATE",
        "max_travel_time_minutes": 60
      },
      "MENINGITIS": {
        "required_capability": "lumbar_puncture",
        "minimum_facility_type": "Secondary",
        "preferred_facility_type": "Tertiary",
        "urgency": "IMMEDIATE",
        "max_travel_time_minutes": 120
      },
      "SAM": {
        "required_capability": "therapeutic_feeding_centre",
        "minimum_facility_type": "PHC",
        "preferred_facility_type": "TFC",
        "urgency": "SAME_DAY",
        "max_travel_time_minutes": 240
      },
      "TUBERCULOSIS": {
        "required_capability": "dots_tb",
        "minimum_facility_type": "PHC",
        "preferred_facility_type": "DOTS",
        "urgency": "WITHIN_48H",
        "max_travel_time_minutes": 480
      }
    }
  },
